{
  "name": "zotero-geyi-translator",
  "version": "0.10.0",
  "description": "格译 Geyi 的 Zotero 插件：右键条目翻译其中的 PDF，保留原版式或 AI 重排，可输出双语对照，译文作为子附件挂回原条目",
  "config": {
    "addonName": "Geyi Translator",
    "addonID": "geyi-zotero-translator@geyi.net",
    "addonRef": "geyi",
    "addonInstance": "GeyiTranslator",
    "prefsPrefix": "extensions.zotero.geyi"
  },
  "type": "module",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "publish:web": "bash scripts/publish-web.sh",
    "release": "zotero-plugin release"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "zotero-plugin-scaffold": "^0.5.0",
    "zotero-types": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nayuta-9/zotero-geyi-translator.git"
  }
}
